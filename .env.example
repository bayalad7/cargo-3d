# Copia este archivo a .env. .env NUNCA se sube al repo.
# Valores para DESARROLLO en tu computadora (ver docs/src/adr/0024-desarrollo-sin-contrasena.md).
POSTGRES_DB=cargo3d
POSTGRES_USER=cargo3d
# Vacía a propósito: en desarrollo PostgreSQL no pide contraseña (POSTGRES_HOST_AUTH_METHOD=trust).
# Es seguro porque el puerto solo escucha en 127.0.0.1. En producción SIEMPRE lleva contraseña
# y se borra la línea de trust.
POSTGRES_PASSWORD=
POSTGRES_HOST_AUTH_METHOD=trust
# Puerto en tu computadora. 5433 y no 5432 para no chocar con un PostgreSQL instalado en el sistema.
POSTGRES_PORT=5433
API_PORT=8080
