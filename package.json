{
  "name": "cargo-3d",
  "private": true,
  "description": "Cargo 3D — planeación de carga 3D para contenedores y camiones",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "docs": "mdbook serve docs --open",
    "api": "go run ./backend/cmd/api",
    "test:go": "go test ./backend/...",
    "db:up": "docker compose up -d db"
  },
  "devDependencies": {
    "turbo": "^2.11.13"
  }
}
