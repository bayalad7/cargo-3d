{
  "name": "@cargo-3d/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Sistema de diseño Voxa: tokens, estilos con Tailwind CSS v4, logo y componentes base (ADR-0014)",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./components.css": "./src/styles/components.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./brand/*": "./src/brand/*"
  },
  "scripts": {
    "lint": "tsc --noEmit -p tsconfig.json",
    "build:preview": "tailwindcss -i ./preview/preview.css -o ./preview/dist/preview.css",
    "preview": "tailwindcss -i ./preview/preview.css -o ./preview/dist/preview.css --watch"
  },
  "dependencies": {
    "lucide-react": "^1.77.0"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/react": "^19.3.0",
    "lucide": "^1.77.0",
    "react": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  }
}
